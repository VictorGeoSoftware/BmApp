<?xml version="1.0" encoding="utf-8"?>
<!--
  Dev-flavour launcher background: a purple gradient, so Firebase builds are
  instantly distinguishable from the yellow Play build on a tester's home
  screen (both can be installed side by side via the `.dev` applicationId
  suffix).

  Mirrors the prod gradient geometry, swapping the yellow ramp for purple:
  prod #FFFACC15 (yellow-400) -> dev #FFA855F7 (purple-500)
  prod #FFF59E0B (amber-500)  -> dev #FF7E22CE (purple-700)

  Kept fully opaque on purpose: a literal alpha here would punch a transparent
  hole in the icon mask, because the launcher composites this layer against no
  backdrop.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="14"
                android:startY="0"
                android:endX="94"
                android:endY="108">
                <item android:color="#FFA855F7" android:offset="0.0" />
                <item android:color="#FF7E22CE" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
