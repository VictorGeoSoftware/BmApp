                  "id": "O7tHEF",
                  "name": "Rule",
                  "fill": "$muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "R4 · Servicios extra es opcional: no bloquea (decision del broker).",
                  "fontFamily": "$font",
                  "fontSize": 11,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "I4ETy",
                  "name": "Rule",
                  "fill": "$muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "R5 · Si el usuario llega a una ruta bloqueada (deep link, restauracion de estado), se redirige a Condiciones actuales.",
                  "fontFamily": "$font",
                  "fontSize": 11,
                  "fontWeight": "normal"
