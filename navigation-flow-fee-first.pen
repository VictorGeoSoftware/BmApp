                  "type": "text",
                  "id": "u3JGBI",
                  "name": "Rule",
                  "fill": "$muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "R3 · Propuestas y Configuracion quedan bloqueadas hasta que TODOS los periodos de potencia y energia tengan un valor valido mayor que cero.",
                  "fontFamily": "$font",
                  "fontSize": 11,
                  "fontWeight": "normal"
