                  "type": "text",
                  "id": "tNDUc",
                  "name": "Rule",
                  "fill": "$muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "R2 · Sin consumo obtenido, Condiciones actuales muestra el estado vacio y solo ofrece Escanear CUPS o Subir PDF.",
                  "fontFamily": "$font",
                  "fontSize": 11,
                  "fontWeight": "normal"
                },
